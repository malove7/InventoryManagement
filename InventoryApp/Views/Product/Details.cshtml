@model InventoryApp.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold">@Model.Name</h5>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
            <div class="card-body px-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">SKU</dt>
                    <dd class="col-sm-8"><code>@(Model.SKU ?? "—")</code></dd>

                    <dt class="col-sm-4 text-muted">Category</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Category" asp-action="Index">@Model.Category?.Name</a>
                    </dd>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <dt class="col-sm-4 text-muted">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>
                    }

                    <dt class="col-sm-4 text-muted">Unit Price</dt>
                    <dd class="col-sm-8 fw-semibold">$@Model.Price.ToString("N2")</dd>

                    <dt class="col-sm-4 text-muted">Added</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("MMM d, yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Last Updated</dt>
                    <dd class="col-sm-8">@Model.UpdatedAt.ToString("MMM d, yyyy h:mm tt")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-body text-center py-4">
                <div class="fs-1 fw-bold @(Model.Quantity == 0 ? "text-danger" : Model.IsLowStock ? "text-warning" : "text-success")">
                    @Model.Quantity
                </div>
                <div class="text-muted">units in stock</div>
                @if (Model.Quantity == 0)
                {
                    <span class="badge badge-out mt-2">Out of Stock</span>
                }
                else if (Model.IsLowStock)
                {
                    <span class="badge badge-low mt-2">Low Stock (threshold: @Model.LowStockThreshold)</span>
                }
                else
                {
                    <span class="badge badge-ok mt-2">In Stock</span>
                }
                <div class="mt-3 pt-3 border-top">
                    <div class="text-muted small">Total Stock Value</div>
                    <div class="fs-5 fw-semibold">$@Model.TotalValue.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white border-0 pt-3 px-3">
                <h6 class="mb-0 fw-semibold">Adjust Stock</h6>
            </div>
            <div class="card-body">
                <form asp-action="AdjustStock" asp-route-id="@Model.Id" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Adjustment Amount</label>
                        <div class="input-group">
                            <input type="number" name="adjustment" class="form-control" placeholder="e.g. +10 or -5" required />
                            <span class="input-group-text">units</span>
                        </div>
                        <div class="form-text">Use positive to add stock, negative to remove.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Reason <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="text" name="reason" class="form-control" placeholder="e.g. Received shipment" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-arrow-repeat me-1"></i>Update Stock
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
