@model InventoryApp.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-danger">
            <div class="card-body text-center py-4">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:3rem"></i>
                <h5 class="mt-3 fw-semibold">Delete Product?</h5>
                <p class="text-muted">
                    You are about to permanently delete <strong>@Model.Name</strong>.
                    This action cannot be undone.
                </p>
                <dl class="row text-start mx-2 mb-3">
                    <dt class="col-5 text-muted">Category</dt>
                    <dd class="col-7">@Model.Category?.Name</dd>
                    <dt class="col-5 text-muted">Stock</dt>
                    <dd class="col-7">@Model.Quantity units</dd>
                    <dt class="col-5 text-muted">Value</dt>
                    <dd class="col-7">$@Model.TotalValue.ToString("N2")</dd>
                </dl>
                <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
