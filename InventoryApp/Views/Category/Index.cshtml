@model IEnumerable<InventoryApp.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0 fw-semibold">All Categories</h5>
        <small class="text-muted">@Model.Count() categories total</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-folder-plus me-1"></i>New Category
    </a>
</div>

<div class="row g-3">
    @foreach (var cat in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="card-title mb-0 fw-semibold">@cat.Name</h6>
                            <small class="text-muted">Added @cat.CreatedAt.ToString("MMM d, yyyy")</small>
                        </div>
                        <span class="badge bg-primary rounded-pill">@cat.Products.Count products</span>
                    </div>
                    @if (!string.IsNullOrEmpty(cat.Description))
                    {
                        <p class="card-text text-muted small mt-2">@cat.Description</p>
                    }
                </div>
                <div class="card-footer bg-white border-0 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box"></i> View Products
                    </a>
                    <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-danger ms-auto">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card text-center py-5">
                <i class="bi bi-tags text-muted" style="font-size:3rem"></i>
                <h5 class="mt-3">No categories yet</h5>
                <p class="text-muted">Create your first category to start organizing products.</p>
                <div><a asp-action="Create" class="btn btn-primary">Create Category</a></div>
            </div>
        </div>
    }
</div>
