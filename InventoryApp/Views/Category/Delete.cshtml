@model InventoryApp.Models.Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-danger">
            <div class="card-body text-center py-4">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:3rem"></i>
                <h5 class="mt-3 fw-semibold">Delete Category?</h5>
                <p class="text-muted">You are about to delete <strong>@Model.Name</strong>.</p>
                @if (Model.Products.Any())
                {
                    <div class="alert alert-warning text-start">
                        <i class="bi bi-info-circle me-1"></i>
                        This category has <strong>@Model.Products.Count</strong> product(s) and cannot be deleted until all products are removed or reassigned.
                    </div>
                }
                <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger" @(Model.Products.Any() ? "disabled" : "")>
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
